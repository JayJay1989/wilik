SECRET_KEY=change-me-to-a-long-random-value

# Off-site backups -- see DEPLOY.md "Backups" section for setup
BACKUP_S3_BUCKET=your-bucket-name
BACKUP_S3_ACCESS_KEY_ID=your-access-key-id
BACKUP_S3_SECRET_ACCESS_KEY=your-secret-access-key
# BACKUP_S3_ENDPOINT=s3.amazonaws.com  # override for non-AWS S3-compatible providers
# BACKUP_NOTIFICATION_URL=ntfy://ntfy.sh/your-topic-name  # optional, push notification if a backup fails
