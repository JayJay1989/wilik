{
  "name": "wilik",
  "description": "A self-hosted wishlist app",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joostvanopdorp/wilik"
  },
  "scripts": {
    "dev:backend": "cd backend && venv\\Scripts\\python.exe app.py",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
